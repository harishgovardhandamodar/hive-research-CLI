# Hive Research — local-only, no cloud keys required
# Copy to .env or export; also configurable via ~/.hive/config.toml

# Provider selection: auto | ollama | lmstudio
HIVE_PROVIDER=auto

# Ollama (default http://localhost:11434). For Docker Open WebUI use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
HIVE_OLLAMA_MODEL=llama3.1:8b

# LM Studio (default http://localhost:1234/v1) — OpenAI-compatible local server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
HIVE_LMSTUDIO_MODEL=qwen/qwen3.8-27b

# Optional: OpenAlex mailto for polite pool (rate-limit courtesy)
# OPENALEX_MAILTO=you@example.com
